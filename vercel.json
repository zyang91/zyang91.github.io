{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": null,
	"outputDirectory": ".",
	"trailingSlash": false,
	"github": {
		"enabled": false
	},
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex"
				}
			]
		},
		{
			"source": "/assets/(.*).pdf",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/pdf"
				},
				{
					"key": "Content-Disposition",
					"value": "inline"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
